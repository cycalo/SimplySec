<Project Sdk="Microsoft.NET.Sdk">
  <!-- View-model, background-runner and window tests. No OS changes. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>SimplySec.App.Tests</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <NoWarn>$(NoWarn);CA1304;CA1305;CA1309;CA1310;CA1311</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SimplySec.App\SimplySec.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SimplySec.Core.Tests\Support\Fakes.cs" Link="Support\Fakes.cs" />
    <Compile Include="..\SimplySec.Core.Tests\Support\Golden.cs" Link="Support\Golden.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
