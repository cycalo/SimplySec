<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure logic: net10.0 (not -windows), so the compiler keeps OS access out of the core. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimplySec.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <!-- The knowledge base (ports, programs, services) and the IEEE OUI vendor list. -->
    <EmbeddedResource Include="Resources\knowledge\*.toml" LogicalName="knowledge/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\oui.csv.gz" LogicalName="resources/oui.csv.gz" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SimplySec.Core.Tests" />
  </ItemGroup>
</Project>
