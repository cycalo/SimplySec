<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The windowed app, SimplySec.exe. With CLI arguments (scan, fix, monitor ...) it runs the
    command without a window: the elevated helper and the daily-check task use this.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SimplySec</AssemblyName>
    <RootNamespace>SimplySec.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\simplysec.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Description>SimplySec</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SimplySec.Commands\SimplySec.Commands.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\simplysec.ico" Link="simplysec.ico" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SimplySec.App.Tests" />
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
