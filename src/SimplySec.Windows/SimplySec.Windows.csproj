<Project Sdk="Microsoft.NET.Sdk">
  <!-- The only layer that touches the OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>SimplySec.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SimplySec.Core\SimplySec.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only for SIMPLYSEC_FACTS=ps1 and the facts test; not shipped (scans no longer run PowerShell). -->
    <None Include="..\simplysec\windows\scripts\facts.ps1" Link="scripts\facts.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SimplySec.Windows.Tests" />
    <InternalsVisibleTo Include="SimplySec.Spikes" />
  </ItemGroup>
</Project>
