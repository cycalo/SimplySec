<Project Sdk="Microsoft.NET.Sdk">
  <!-- The only layer that touches the OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>SimplySec.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SimplySec.Core\SimplySec.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\simplysec\windows\scripts\facts.ps1" LogicalName="scripts/facts.ps1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SimplySec.Windows.Tests" />
    <InternalsVisibleTo Include="SimplySec.Spikes" />
  </ItemGroup>
</Project>
